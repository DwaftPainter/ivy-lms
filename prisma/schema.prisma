// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ENUMS

enum Role {
  TEACHER
  STUDENT
  ADMIN
}

enum IeltsSkill {
  LISTENING
  READING
  WRITING
  SPEAKING
}

enum LessonType {
  VIDEO
  DOCUMENT
  QUIZ
  LIVE_SESSION
}

enum AssignmentType {
  WRITING_TASK1
  WRITING_TASK2
  SPEAKING
  LISTENING
  READING
  MOCK_TEST
}

enum SubmissionStatus {
  PENDING
  SUBMITTED
  GRADED
  RETURNED
}

enum EnrollmentStatus {
  STUDYING
  DONE
  UPCOMING
}

enum CourseLevel {
  BEGINNER // Band 0–4
  INTERMEDIATE // Band 4.5–6
  ADVANCED // Band 6.5–9
}

enum AuthProvider {
  LOCAL
  GOOGLE
}

enum UserStatus {
  ACTIVE
  LOCKED
}

model User {
  id           String       @id @default(uuid())
  email        String       @unique
  // phone     String   @unique
  password     String?
  firstName    String
  lastName     String
  avatarUrl    String?
  role         Role
  isActive     Boolean      @default(true)
  authProvider AuthProvider

  // Lock attempt
  status              UserStatus @default(ACTIVE)
  failedLoginAttempts Int        @default(0)
  lockedAt            DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  teacherProfile     TeacherProfile?
  studentProfile     StudentProfile?
  notifications      Notification[]
  submissionComments SubmissionComment[]

  @@map("users")
}

model TeacherProfile {
  id        String       @id @default(uuid())
  userId    String       @unique
  bio       String?
  expertise IeltsSkill[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  user              User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  courses           Course[]
  gradedSubmissions AssignmentSubmission[]
  classSessions     ClassSession[]

  @@map("teacher_profiles")
}

model StudentProfile {
  id               String   @id @default(uuid())
  userId           String   @unique
  targetBandScore  Float?
  currentBandScore Float?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user             User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  enrollments      Enrollment[]
  submissions      AssignmentSubmission[]
  lessonProgress   LessonProgress[]
  bandScoreHistory BandScoreHistory[]

  @@map("student_profiles")
}

model Course {
  id           String      @id @default(uuid())
  teacherId    String
  title        String
  description  String?
  thumbnailUrl String?
  skill        IeltsSkill
  level        CourseLevel
  targetBand   Float?
  isPublished  Boolean     @default(false)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  teacher       TeacherProfile @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  lessons       Lesson[]
  enrollments   Enrollment[]
  tags          CourseTag[]
  classSessions ClassSession[]

  @@map("courses")
}

model CourseTag {
  id       String @id @default(uuid())
  courseId String
  tag      String

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([courseId, tag])
  @@map("course_tags")
}

model Lesson {
  id            String     @id @default(uuid())
  courseId      String
  title         String
  description   String?
  type          LessonType
  order         Int
  durationMins  Int?
  contentUrl    String? // video URL, doc URL, etc.
  content       String? // rich-text / markdown body
  isPublished   Boolean    @default(false)
  isFreePreview Boolean    @default(false)

  // For LIVE_SESSION lessons
  scheduledStart DateTime?
  scheduledEnd   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  course    Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  resources LessonResource[]
  progress  LessonProgress[]

  @@unique([courseId, order])
  @@map("lessons")
}

model LessonResource {
  id        String   @id @default(uuid())
  lessonId  String
  name      String
  fileUrl   String
  fileType  String
  createdAt DateTime @default(now())

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@map("lesson_resources")
}

model LessonProgress {
  id          String    @id @default(uuid())
  studentId   String
  lessonId    String
  isCompleted Boolean   @default(false)
  watchedSecs Int?      @default(0)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  student StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  lesson  Lesson         @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([studentId, lessonId])
  @@map("lesson_progress")
}

model Assignment {
  id             String         @id @default(uuid())
  classSessionId String?
  title          String
  description    String
  type           AssignmentType
  skill          IeltsSkill
  dueDate        DateTime?
  maxScore       Float          @default(9.0)
  instructions   String?
  attachmentUrl  String?
  isPublished    Boolean        @default(false)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  classSession ClassSession?          @relation(fields: [classSessionId], references: [id], onDelete: SetNull)
  submissions  AssignmentSubmission[]
  rubric       Rubric?

  @@map("assignments")
}

model Rubric {
  id           String   @id @default(uuid())
  assignmentId String   @unique
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  assignment Assignment        @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  criteria   RubricCriterion[]

  @@map("rubrics")
}

model RubricCriterion {
  id          String  @id @default(uuid())
  rubricId    String
  name        String // e.g. "Task Achievement", "Coherence", "Lexical Resource", "Grammar"
  description String?
  maxScore    Float

  rubric Rubric @relation(fields: [rubricId], references: [id], onDelete: Cascade)

  scores CriterionScore[]

  @@map("rubric_criteria")
}

model AssignmentSubmission {
  id           String           @id @default(uuid())
  assignmentId String
  studentId    String
  gradedById   String?
  status       SubmissionStatus @default(PENDING)
  content      String? // text answer (Writing tasks) or JSON for other skills
  fileUrl      String? // uploaded file
  audioUrl     String? // for single Speaking submission (legacy)
  audioUrls    Json? // for multiple Speaking recordings: [{questionId, url, duration}]
  score        Float?
  bandScore    Float? // IELTS band equivalent
  feedback     String?
  submittedAt  DateTime?
  gradedAt     DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  // AI Grading Fields
  aiScore          Float? // AI calculated band score
  aiFeedback       String? // AI generated feedback
  aiGradedAt       DateTime?
  aiCorrections    Json? // Array of corrections: [{original, corrected, explanation, position}]
  teacherRegradeRequested Boolean @default(false)
  regradeRequestedAt DateTime?

  assignment     Assignment          @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student        StudentProfile      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  gradedBy       TeacherProfile?     @relation(fields: [gradedById], references: [id], onDelete: SetNull)
  criteriaScores CriterionScore[]
  comments       SubmissionComment[]

  @@unique([assignmentId, studentId])
  @@map("assignment_submissions")
}

model CriterionScore {
  id    String @id @default(uuid())
  score Float

  submissionId String
  criterionId  String

  submission AssignmentSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  criterion RubricCriterion @relation(fields: [criterionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SubmissionComment {
  id           String   @id @default(uuid())
  submissionId String
  authorId     String // userId (teacher or student)
  content      String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  submission AssignmentSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  author     User                 @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@map("submission_comments")
}

model Enrollment {
  id          String           @id @default(uuid())
  studentId   String
  courseId    String
  status      EnrollmentStatus @default(UPCOMING)
  enrolledAt  DateTime         @default(now())
  completedAt DateTime?
  updatedAt   DateTime         @updatedAt

  student       StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course        Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  classSessions ClassSession[]
  attendances   Attendance[]

  @@unique([studentId, courseId])
  @@map("enrollments")
}

model ClassSession {
  id            String     @id @default(uuid())
  courseId      String
  teacherId     String
  title         String
  description   String?
  skill         IeltsSkill
  sessionType   String     @default("LIVE") // LIVE, RECORDED, WORKSHOP
  scheduledDate DateTime // Date of the session
  startTime     String // HH:mm format
  endTime       String // HH:mm format
  durationMins  Int        @default(60)
  meetingUrl    String? // For online sessions
  isPublished   Boolean    @default(false)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  course      Course            @relation(fields: [courseId], references: [id], onDelete: Cascade)
  teacher     TeacherProfile    @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  enrollments Enrollment[]
  attendances Attendance[]
  assignments Assignment[]
  materials   SessionMaterial[]

  @@map("class_sessions")
}

model SessionMaterial {
  id        String   @id @default(uuid())
  sessionId String
  name      String
  fileUrl   String
  fileType  String   // PDF, VIDEO, LINK, AUDIO
  createdAt DateTime @default(now())

  classSession ClassSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("session_materials")
}

model Attendance {
  id             String           @id @default(uuid())
  classSessionId String
  enrollmentId   String
  attendedAt     DateTime?
  status         AttendanceStatus @default(SCHEDULED)
  notes          String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  classSession ClassSession @relation(fields: [classSessionId], references: [id], onDelete: Cascade)
  enrollment   Enrollment   @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@unique([classSessionId, enrollmentId])
  @@map("attendances")
}

enum AttendanceStatus {
  SCHEDULED
  ATTENDED
  ABSENT
  EXCUSED
}

model BandScoreHistory {
  id        String     @id @default(uuid())
  studentId String
  skill     IeltsSkill
  band      Float
  source    String? // "Mock Test", "Assignment", "Official"
  takenAt   DateTime
  createdAt DateTime   @default(now())

  student StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@map("band_score_history")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  body      String
  isRead    Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}
